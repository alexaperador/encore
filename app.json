{
  "expo": {
    "name": "encore",
    "slug": "encore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/encore.jpg",
    "scheme": "encore",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aaperadors.encore",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/encore.jpg",
        "backgroundImage": "./assets/images/encore.jpg",
        "monochromeImage": "./assets/images/encore-monochrome.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aaperadors.encore",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/encore.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "concert-reminders"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Encore necesita acceso a tu calendario para añadir conciertos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/encore.jpg",
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE"
        }
      ],
      "expo-widgets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.aaperadors.encore.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.aaperadors.encore"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "f7165b1d-e5e9-41ac-8039-bacaa009b83c"
      }
    }
  }
}
